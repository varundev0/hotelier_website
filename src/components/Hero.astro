---
import { APP_LOGIN_URL, DEMO, inr } from '../config';
const months = ['Jan','Feb','Mar','Apr','May','Jun','Jul','Aug','Sep','Oct','Nov','Dec'];
// Weeks are 0-indexed columns of the 52-week heatmap.
const DIWALI_WEEK = 42; // late October, matching the flagged month in the walkthrough
const MONSOON = { from: 25, to: 34 };
const facts = [
  { k: 'Rooms', v: String(DEMO.rooms) },
  { k: 'Occupancy, 30 days', v: `${DEMO.occupancyPct}%` },
  { k: 'ADR', v: inr(DEMO.adr) },
  { k: 'RevPAR', v: inr(DEMO.revpar) },
  { k: 'History', v: `${DEMO.historyYears} years` },
];
---

<header class="hero">
  <div class="wrap">
    <div class="g7 hero-top">
      <div class="c1-4">
        <p class="hero-cat">Revenue management for independent hotels</p>
        <h1>Every night has a right price. See yours.</h1>
      </div>
      <div class="c5-7 hero-side">
        <p class="hero-sub">
          HotelierOS reads your booking history and shows demand by night, what
          each channel really costs, and the rate to charge.
        </p>
        <div class="hero-cta">
          <a href="#request" class="btn btn-primary btn-lg">Request access</a>
          <a href={APP_LOGIN_URL} class="btn btn-ghost btn-lg">Log in</a>
        </div>
        <p class="hero-note">Built for small-to-midsize hotels. Reported in ₹.</p>
      </div>
    </div>

    <!-- The sample property and its year of demand: the subject of the page. -->
    <div class="panel heat-panel" id="heatCard">
      <div class="prop-strip">
        <div class="prop-name">
          <b>{DEMO.hotelName}</b>
          <span>{DEMO.location} · sample property<sup class="fn"><a href="#notes" aria-label="Note 1">1</a></sup></span>
        </div>
        <dl class="prop-facts">
          {facts.map((f) => (
            <div><dt>{f.k}</dt><dd>{f.v}</dd></div>
          ))}
        </dl>
      </div>
      <div class="heat-body">
        <div class="heat-head">
          <span class="heat-title">Occupancy by night, last 12 months</span>
          <div class="heat-legend" aria-hidden="true">
            <span>Quiet</span>
            <span class="legend-scale">
              <i style="background:var(--demand-1)"></i>
              <i style="background:var(--demand-2)"></i>
              <i style="background:var(--demand-3)"></i>
              <i style="background:var(--demand-4)"></i>
              <i style="background:var(--demand-5)"></i>
            </span>
            <span>Full</span>
          </div>
        </div>
        <div class="heat-annot" aria-hidden="true">
          <div class="annot-span" style={`--from:${MONSOON.from};--to:${MONSOON.to}`}><span>Monsoon trough</span></div>
          <div class="annot-flag" style={`--wk:${DIWALI_WEEK}`}>Diwali week −18%</div>
        </div>
        <div
          class="heatmap"
          id="heatmap"
          data-flag-week={DIWALI_WEEK}
          role="img"
          aria-label={`Heatmap of nightly occupancy over 52 weeks: busiest October to February, a monsoon trough in July and August, and Diwali week flagged: ${DEMO.anomaly}.`}
        ></div>
        <div class="heat-months" aria-hidden="true">
          {months.map((m) => <span>{m}</span>)}
        </div>
      </div>
    </div>
  </div>
</header>

<script>
  import { demandColor, seasonal, onFirstView } from '../scripts/demo';

  // 7 rows (days) x 52 columns (weeks): a full year, so the Jan–Dec labels hold
  // at every width. Columns sweep in left to right once — a year passing.
  const weeks = 52;
  const hm = document.getElementById('heatmap');
  if (hm) {
    const flagWeek = Number(hm.dataset.flagWeek);
    for (let w = 0; w < weeks; w++) {
      const col = document.createElement('div');
      col.className = 'heat-col';
      col.style.setProperty('--i', String(w));
      for (let d = 0; d < 7; d++) {
        let v = seasonal(w * 7 + d);
        if (d === 5 || d === 6) v = Math.min(0.99, v + 0.12); // weekend lift
        const c = document.createElement('div');
        c.className = 'cell';
        if (w === flagWeek) {
          v *= 0.82; // the 18% drop the annotation calls out
          c.classList.add('flag');
        }
        c.style.background = demandColor(v);
        col.appendChild(c);
      }
      hm.appendChild(col);
    }
  }
  const card = document.getElementById('heatCard');
  if (card) onFirstView([card], 0.15);
</script>
