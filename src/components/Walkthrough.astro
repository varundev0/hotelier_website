---
import { DEMO, CORRIDOR_LABEL, inr } from '../config';
const months = ['J','F','M','A','M','J','J','A','S','O','N','D'];
const corridorPts = '0,110 46,96 92,102 137,78 183,70 229,58 274,66 320,52';
---

<section class="sec" id="walk">
  <div class="wrap">
    <div class="g7 sec-head sec-rule">
      <p class="sec-label c1">Walkthrough</p>
      <h2 class="c2-7">What HotelierOS reads from one export.</h2>
    </div>

    <ol class="rows">
      <!-- Day 0: onboarding + upload (was How it works) -->
      <li class="row g7">
        <p class="row-mark c1">Day 0</p>
        <div class="row-copy c2-3">
          <h3>We set up your workspace. You upload your history.</h3>
          <p>Your property is mapped before you log in. Then drop in a PMS or booking export, with nothing to configure.</p>
        </div>
        <div class="panel c4-7">
          <div class="panel-head"><b>Upload</b><span>{DEMO.hotelName}</span></div>
          <div class="upload-file">grand-cascade_bookings.csv <span>{DEMO.historyYears} years of bookings</span></div>
          <ul class="upload-steps">
            <li>Mapped to {DEMO.rooms} rooms</li>
            <li>Channels separated: OTA, direct, corporate, travel agent</li>
            <li>KPIs, channel mix and seasonality computed</li>
          </ul>
        </div>
      </li>

      <!-- Day 1: the numbers -->
      <li class="row g7">
        <p class="row-mark c1">Day 1</p>
        <div class="row-copy c2-3">
          <h3>The metrics that matter, without the spreadsheet.</h3>
          <p>Occupancy, ADR and RevPAR compute from a single upload and refresh with every new export.</p>
        </div>
        <div class="panel c4-7">
          <div class="panel-head"><b>Performance</b><span>Last 30 days vs prior 30</span></div>
          <div class="kpis">
            <div class="kpi"><div class="lab">Occupancy</div><div class="val">{DEMO.occupancyPct}%</div><div class="d">▲ 4.2%</div></div>
            <div class="kpi"><div class="lab">ADR</div><div class="val">{inr(DEMO.adr)}</div><div class="d">▲ 2.8%</div></div>
            <div class="kpi"><div class="lab">RevPAR</div><div class="val">{inr(DEMO.revpar)}</div><div class="d">▲ 7.1%</div></div>
          </div>
        </div>
      </li>

      <!-- Day 1: channels -->
      <li class="row g7">
        <p class="row-mark c1">Day 1</p>
        <div class="row-copy c2-3">
          <h3>Know what each channel really costs you.</h3>
          <p>Direct, corporate and travel-agent business stay distinct. Booking.com, Expedia, MakeMyTrip and the rest roll up into one commission-weighted OTA line.</p>
        </div>
        <div class="panel c4-7 anim">
          <div class="panel-head"><b>Revenue by channel</b><span>Share of room revenue</span></div>
          {DEMO.channels.map((c) => (
            <div class="chan">
              <span class="nm">{c.name}</span>
              <div class="track"><div class="fill" style={`--w:${c.pct}%;background:${c.color}`}></div></div>
              <span class="pc">{c.pct}%</span>
            </div>
          ))}
        </div>
      </li>

      <!-- Day 1: seasons -->
      <li class="row g7">
        <p class="row-mark c1">Day 1</p>
        <div class="row-copy c2-3">
          <h3>See the demand patterns you've been guessing at.</h3>
          <p>Years of bookings become one heatmap. A soft week against last year gets flagged automatically.</p>
        </div>
        <div class="panel c4-7">
          <div class="panel-head"><b>Seasonality</b><span>Rolling {DEMO.historyYears}-year view</span></div>
          <div class="mini-heat" id="miniHeat" aria-hidden="true"></div>
          <div class="mini-months" aria-hidden="true">{months.map((m) => <span>{m}</span>)}</div>
          <div class="anomaly-tag"><i></i> {DEMO.anomaly}</div>
        </div>
      </li>

      <!-- Week 1: the price -->
      <li class="row g7">
        <p class="row-mark c1">Week 1</p>
        <div class="row-copy c2-3">
          <h3>The rate your own data supports.</h3>
          <p>A price-elasticity model gives you a rate corridor for each season and day of week: a band to price inside, not a number to argue with.<sup class="fn"><a href="#notes" aria-label="Note 2">2</a></sup></p>
        </div>
        <div class="panel c4-7 anim">
          <div class="panel-head"><b>Rate corridor</b><span>This weekend · high season · Fri–Sat</span></div>
          <svg class="corr-svg" viewBox="0 0 320 130" preserveAspectRatio="none" role="img" aria-label={`Rate trend rising into a recommended corridor of ${CORRIDOR_LABEL}`}>
            <rect x="0" y="40" width="320" height="42" fill="var(--signal-tint)"></rect>
            <line x1="0" y1="40" x2="320" y2="40" stroke="var(--signal)" stroke-width="1" stroke-dasharray="4 3"></line>
            <line x1="0" y1="82" x2="320" y2="82" stroke="var(--signal)" stroke-width="1" stroke-dasharray="4 3"></line>
            <polyline class="corr-line" fill="none" stroke="var(--ink)" stroke-width="2" points={corridorPts} stroke-linecap="round" stroke-linejoin="round"></polyline>
          </svg>
          <div class="rec-rate"><span class="big">{CORRIDOR_LABEL}</span><span>Recommended corridor</span></div>
        </div>
      </li>
    </ol>
  </div>
</section>

<script>
  import { demandColor, seasonal, onFirstView } from '../scripts/demo';

  // Mini seasonality heatmap: 12 months x 6 samples; October carries the flag.
  const mh = document.getElementById('miniHeat');
  if (mh) {
    for (let c = 0; c < 12; c++) {
      const col = document.createElement('div');
      col.className = 'mini-col';
      for (let r = 0; r < 6; r++) {
        const cell = document.createElement('div');
        cell.className = 'mini-cell';
        cell.style.background = (c === 9 && r < 2) ? 'var(--watch)' : demandColor(seasonal(c * 30 + r * 5));
        col.appendChild(cell);
      }
      mh.appendChild(col);
    }
  }

  // Bars fill and the corridor line draws once, when each panel enters view.
  onFirstView(Array.from(document.querySelectorAll('#walk .anim')), 0.4);
</script>
