---
import { DEMO } from '../config';
---

<section class="walk" id="walk">
  <div class="wrap">
    <div class="step-dots" id="stepDots" role="tablist" aria-label="Walkthrough progress">
      <button class="dot active" type="button" data-step="0" role="tab" aria-selected="true" aria-label="Step 1 of 4: The numbers"></button>
      <button class="dot" type="button" data-step="1" role="tab" aria-selected="false" aria-label="Step 2 of 4: Your channels"></button>
      <button class="dot" type="button" data-step="2" role="tab" aria-selected="false" aria-label="Step 3 of 4: Your seasons"></button>
      <button class="dot" type="button" data-step="3" role="tab" aria-selected="false" aria-label="Step 4 of 4: Your price"></button>
    </div>
    <div class="walk-grid">
      <!-- Pinned visual -->
      <div class="walk-visual">
        <div class="stage">
          <div class="stage-head">
            <div class="t">{DEMO.hotelName} <small>Performance</small></div>
            <span class="badge-live">Illustrative data</span>
          </div>

          <!-- layer 1: KPIs -->
          <div class="layer" data-layer="0">
            <div class="kpis">
              <div class="kpi"><div class="lab">Occupancy</div><div class="val"><span class="cu" data-count="78.4" data-suffix="%" data-dec="1">0</span></div><div class="d">▲ 4.2%</div></div>
              <div class="kpi"><div class="lab">ADR</div><div class="val">₹<span class="cu" data-count="7020">0</span></div><div class="d">▲ 2.8%</div></div>
              <div class="kpi"><div class="lab">RevPAR</div><div class="val">₹<span class="cu" data-count="5504">0</span></div><div class="d">▲ 7.1%</div></div>
            </div>
            <p class="kpi-note">Occupancy, ADR and RevPAR computed automatically from a single CSV upload — no spreadsheet to maintain.</p>
          </div>

          <!-- layer 2: channels -->
          <div class="layer" data-layer="1">
            {DEMO.channels.map((c) => (
              <div class="chan">
                <div class="chan-top"><span class="nm">{c.name}</span><span class="pc">{c.pct}%</span></div>
                <div class="track"><div class="fill" style={`--w:${c.pct}%;background:${c.color}`}></div></div>
              </div>
            ))}
            <p class="kpi-note">Booking.com, Expedia, MakeMyTrip and the rest roll up into one commission-weighted OTA line — so you see the real cost of every channel.</p>
          </div>

          <!-- layer 3: seasonality -->
          <div class="layer" data-layer="2">
            <div class="mini-heat" id="miniHeat"></div>
            <div class="anomaly-tag"><span class="pulse"></span> {DEMO.anomaly}</div>
            <p class="kpi-note">A rolling multi-year heatmap surfaces your peaks and troughs and flags year-over-year drops before they cost you a season.</p>
          </div>

          <!-- layer 4: corridor -->
          <div class="layer" data-layer="3">
            <svg viewBox="0 0 320 150" width="100%" height="150" style="display:block">
              <rect x="0" y="46" width="320" height="42" fill="var(--accent-blue-tint)"></rect>
              <line x1="0" y1="46" x2="320" y2="46" stroke="var(--accent-blue)" stroke-width="1.5" stroke-dasharray="4 3"></line>
              <line x1="0" y1="88" x2="320" y2="88" stroke="var(--accent-blue)" stroke-width="1.5" stroke-dasharray="4 3"></line>
              <polyline id="cline" fill="none" stroke="var(--accent-blue)" stroke-width="2.5" points="" stroke-linecap="round" stroke-linejoin="round"></polyline>
            </svg>
            <div class="rec-rate"><span class="big">{DEMO.corridorLabel}</span></div>
            <div class="corridor-note">Recommended rate corridor for this weekend · high season · Fri–Sat</div>
            <p class="kpi-note">A price-elasticity model turns your demand into a defensible rate band per season and day of week — a corridor with confidence, not a false-precision number.</p>
          </div>
        </div>
      </div>

      <!-- Scrolling steps -->
      <div class="walk-steps">
        <div class="walk-step" data-step="0">
          <div class="num">01 — THE NUMBERS</div>
          <h3>The metrics that matter, without the spreadsheet.</h3>
          <p>Upload your booking history and the KPIs a revenue manager lives by appear instantly — and refresh with every new export. No formulas, no reconciling tabs.</p>
        </div>
        <div class="walk-step" data-step="1">
          <div class="num">02 — YOUR CHANNELS</div>
          <h3>Know what each channel really costs you.</h3>
          <p>Direct, corporate and travel-agent business stay distinct, while every OTA collapses into one commission-weighted line — so the true economics of your mix stop hiding in extranets.</p>
        </div>
        <div class="walk-step" data-step="2">
          <div class="num">03 — YOUR SEASONS</div>
          <h3>See the demand patterns you've been guessing at.</h3>
          <p>Years of bookings become one readable heatmap. Peaks, shoulders and quiet weeks are obvious at a glance, and a soft spot against last year gets flagged automatically.</p>
        </div>
        <div class="walk-step" data-step="3">
          <div class="num">04 — YOUR PRICE</div>
          <h3>The rate your own data supports.</h3>
          <p>HotelierOS models how your demand responds to price and hands you a rate corridor for each season and day of week — a confident band to price inside, not a number to argue with.</p>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  import { demandColor, seasonal, countUp, reduce } from '../scripts/demo';

  // Mini heatmap inside the seasonality beat (12 cols x 6 rows).
  const mh = document.getElementById('miniHeat');
  if (mh) {
    for (let c = 0; c < 12; c++) {
      const col = document.createElement('div');
      col.className = 'mini-col';
      for (let r = 0; r < 6; r++) {
        const day = c * 30 + r * 5;
        const cell = document.createElement('div');
        cell.className = 'mini-cell';
        cell.style.background = demandColor(seasonal(day));
        if (c === 9 && r < 2) cell.style.background = '#fcd9a4'; // anomaly highlight
        col.appendChild(cell);
      }
      mh.appendChild(col);
    }
  }

  // Sticky beats: activate one layer as its step crosses the viewport centre.
  const layers = document.querySelectorAll<HTMLElement>('.stage .layer');
  let kpiCounted = false;
  let corridorDrawn = false;

  function drawCorridor() {
    if (corridorDrawn) return;
    corridorDrawn = true;
    const line = document.getElementById('cline');
    if (!line) return;
    const pts = [[0,110],[46,96],[92,102],[137,78],[183,70],[229,58],[274,66],[320,52]];
    if (reduce) {
      line.setAttribute('points', pts.map((p) => p.join(',')).join(' '));
      return;
    }
    let i = 0;
    (function add() {
      if (i > pts.length) return;
      line.setAttribute('points', pts.slice(0, i).map((p) => p.join(',')).join(' '));
      i++;
      setTimeout(add, 90);
    })();
  }

  // Step progress dots: mirror the active layer and let visitors jump to a step.
  const dots = document.querySelectorAll<HTMLButtonElement>('#stepDots .dot');

  function setLayer(idx: number) {
    layers.forEach((l) => l.classList.toggle('active', Number(l.getAttribute('data-layer')) === idx));
    dots.forEach((d) => {
      const isActive = Number(d.getAttribute('data-step')) === idx;
      d.classList.toggle('active', isActive);
      d.setAttribute('aria-selected', String(isActive));
    });
    if (idx === 0 && !kpiCounted) {
      kpiCounted = true;
      document.querySelectorAll<HTMLElement>('.stage .cu').forEach(countUp);
    }
    if (idx === 3) drawCorridor();
  }
  setLayer(0);

  const stepObs = new IntersectionObserver((entries) => {
    entries.forEach((en) => {
      if (en.isIntersecting) setLayer(Number(en.target.getAttribute('data-step')));
    });
  }, { rootMargin: '-45% 0px -45% 0px', threshold: 0 });
  document.querySelectorAll('.walk-step').forEach((s) => stepObs.observe(s));

  dots.forEach((d) => {
    d.addEventListener('click', () => {
      const target = document.querySelector(`.walk-step[data-step="${d.getAttribute('data-step')}"]`);
      target?.scrollIntoView({ behavior: reduce ? 'auto' : 'smooth', block: 'center' });
    });
  });
</script>
